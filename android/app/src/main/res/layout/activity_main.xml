<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/map_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <org.osmdroid.views.MapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginEnd="@dimen/space_16"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_banner"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_16"
                android:paddingTop="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:paddingBottom="@dimen/space_16"
                android:visibility="gone">

                <TextView
                    android:id="@+id/turn_icon"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="↑"
                    android:textColor="@color/on_banner"
                    android:textSize="40sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/maneuver_dist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.HudNav.Distance"
                        android:textColor="@color/on_banner" />

                    <TextView
                        android:id="@+id/maneuver"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/on_banner" />

                    <TextView
                        android:id="@+id/road"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/banner_sub"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/then_next"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/space_4"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/banner_sub"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/alert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_alert"
                android:elevation="3dp"
                android:paddingStart="@dimen/space_16"
                android:paddingTop="@dimen/space_12"
                android:paddingEnd="@dimen/space_16"
                android:paddingBottom="@dimen/space_12"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/on_banner"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|bottom"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginBottom="@dimen/space_16"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/speed_disc"
                android:layout_width="@dimen/speed_size"
                android:layout_height="@dimen/speed_size"
                android:background="@drawable/bg_speed"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textAppearance="@style/TextAppearance.HudNav.Readout"
                    android:textColor="@color/on_banner" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="km/h"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textColor="@color/banner_sub" />
            </LinearLayout>

            <TextView
                android:id="@+id/limit"
                android:layout_width="@dimen/limit_size"
                android:layout_height="@dimen/limit_size"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_limit"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.HudNav.Limit"
                android:textColor="@color/limit_ink"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="@dimen/space_16"
            android:layout_marginBottom="@dimen/space_16"
            android:orientation="vertical">

            <TextView
                android:id="@+id/overview"
                android:layout_width="@dimen/fab_size"
                android:layout_height="@dimen/fab_size"
                android:layout_gravity="end"
                android:layout_marginBottom="@dimen/space_12"
                android:background="@drawable/bg_fab"
                android:clickable="true"
                android:elevation="3dp"
                android:focusable="true"
                android:gravity="center"
                android:text="⛶"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                android:textColor="@color/ink"
                android:visibility="gone" />

            <TextView
                android:id="@+id/heading"
                android:layout_width="@dimen/fab_size"
                android:layout_height="@dimen/fab_size"
                android:layout_gravity="end"
                android:layout_marginBottom="@dimen/space_12"
                android:background="@drawable/bg_fab"
                android:clickable="true"
                android:elevation="3dp"
                android:focusable="true"
                android:gravity="center"
                android:text="N"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/ink"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/locate"
                android:layout_width="@dimen/fab_size"
                android:layout_height="@dimen/fab_size"
                android:layout_gravity="end"
                android:background="@drawable/bg_fab"
                android:clickable="true"
                android:elevation="3dp"
                android:focusable="true"
                android:gravity="center"
                android:text="⌖"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                android:textColor="@color/nav" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hud_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginEnd="@dimen/space_16"
            android:layout_marginBottom="@dimen/space_12"
            android:background="@drawable/bg_hud"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="@dimen/space_16"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_4">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/lay_icon"
                    style="@style/Widget.HudNav.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="@dimen/space_4"
                    android:layout_weight="1"
                    android:text="@string/lay_icon" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/lay_map"
                    style="@style/Widget.HudNav.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="@dimen/space_4"
                    android:layout_weight="1"
                    android:text="@string/lay_map" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/lay_curve"
                    style="@style/Widget.HudNav.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/lay_curve" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/bright"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="@color/sub" />

            <com.google.android.material.slider.Slider
                android:id="@+id/bright"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1.0"
                android:value="255.0"
                android:valueFrom="0.0"
                android:valueTo="255.0"
                app:labelBehavior="gone"
                app:tickVisible="false" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/mirror"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:text="@string/mirror"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="@color/ink" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/power"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minHeight="@dimen/touch_min"
                android:text="@string/power"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="@color/ink" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/voice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minHeight="@dimen/touch_min"
                android:text="@string/voice"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="@color/ink" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottom_col"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginEnd="@dimen/space_16"
            android:layout_marginBottom="@dimen/space_8"
            android:background="@drawable/bg_search"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:minHeight="@dimen/action_height"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_4">

            <EditText
                android:id="@+id/query"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingTop="@dimen/space_12"
                android:paddingBottom="@dimen/space_12"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="@color/ink"
                android:textColorHint="@color/sub" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/search"
                style="@style/Widget.HudNav.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search"
                android:textColor="@color/accent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_sheet"
            android:elevation="2dp"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_16"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/space_16"
            android:paddingBottom="@dimen/space_16">

            <View
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_4"
                android:background="@drawable/bg_grabber" />

            <TextView
                android:id="@+id/sheet_handle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="@dimen/touch_min"
                android:text="Mostra altro"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="@color/sub" />

            <ScrollView
                android:id="@+id/sheet_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fadeScrollbars="false"
                android:fillViewport="false"
                android:nestedScrollingEnabled="true"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="vertical">

                <LinearLayout
                    android:id="@+id/sheet_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/sheet_nav"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingBottom="@dimen/space_8"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/eta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                            android:textColor="@color/nav" />

                        <TextView
                            android:id="@+id/remain_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textColor="@color/ink" />

                        <TextView
                            android:id="@+id/remain_dist"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textColor="@color/ink" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/sheet_idle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/dest_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Scegli l'arrivo"
                                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                                android:textColor="@color/ink" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/fav"
                                style="@style/Widget.HudNav.Button.Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="@dimen/touch_min"
                                android:text="@string/fav"
                                android:textColor="@color/accent"
                                android:visibility="gone" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/stop_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="@dimen/space_8"
                            android:paddingBottom="@dimen/space_8"
                            android:visibility="gone">

                            <HorizontalScrollView
                                android:id="@+id/stop_scroll"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:clipToPadding="false"
                                android:paddingEnd="@dimen/space_8"
                                android:scrollbars="none">

                                <LinearLayout
                                    android:id="@+id/stops"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal" />
                            </HorizontalScrollView>

                            <TextView
                                android:id="@+id/add_stop"
                                style="@style/Widget.HudNav.Chip"
                                android:layout_marginStart="@dimen/space_8"
                                android:text="@string/add_stop" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingBottom="@dimen/space_4"
                            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                            android:textColor="@color/sub" />

                        <HorizontalScrollView
                            android:id="@+id/alt_scroll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:paddingEnd="@dimen/space_12"
                            android:paddingBottom="@dimen/space_8"
                            android:scrollbars="none"
                            android:visibility="gone">

                            <LinearLayout
                                android:id="@+id/alts"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>

                        <TextView
                            android:id="@+id/avoid"
                            style="@style/Widget.HudNav.Chip"
                            android:layout_marginBottom="@dimen/space_8"
                            android:text="Evita autostrade" />

                        <HorizontalScrollView
                            android:id="@+id/cats_scroll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:paddingEnd="@dimen/space_12"
                            android:scrollbars="none">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/cat_fuel"
                                    style="@style/Widget.HudNav.Chip"
                                    android:layout_marginEnd="@dimen/space_8"
                                    android:text="@string/cat_fuel" />

                                <TextView
                                    android:id="@+id/cat_park"
                                    style="@style/Widget.HudNav.Chip"
                                    android:layout_marginEnd="@dimen/space_8"
                                    android:text="@string/cat_park" />

                                <TextView
                                    android:id="@+id/cat_food"
                                    style="@style/Widget.HudNav.Chip"
                                    android:layout_marginEnd="@dimen/space_8"
                                    android:text="@string/cat_food" />

                                <TextView
                                    android:id="@+id/cat_aid"
                                    style="@style/Widget.HudNav.Chip"
                                    android:text="@string/cat_aid"
                                    android:textColor="@color/nav" />
                            </LinearLayout>
                        </HorizontalScrollView>

                        <ScrollView
                            android:id="@+id/hits_scroll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fadeScrollbars="false"
                            android:scrollbars="vertical"
                            android:visibility="gone">

                            <LinearLayout
                                android:id="@+id/hits"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />
                        </ScrollView>

                        <TextView
                            android:id="@+id/fav_label"
                            style="@style/Widget.HudNav.SectionLabel"
                            android:text="@string/favorites"
                            android:visibility="gone" />

                        <HorizontalScrollView
                            android:id="@+id/fav_scroll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:clipToPadding="false"
                            android:paddingEnd="@dimen/space_12"
                            android:scrollbars="none"
                            android:visibility="gone">

                            <LinearLayout
                                android:id="@+id/favs"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>

                        <TextView
                            android:id="@+id/recent_label"
                            style="@style/Widget.HudNav.SectionLabel"
                            android:text="@string/recents"
                            android:visibility="gone" />

                        <HorizontalScrollView
                            android:id="@+id/recent_scroll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:clipToPadding="false"
                            android:paddingEnd="@dimen/space_12"
                            android:scrollbars="none"
                            android:visibility="gone">

                            <LinearLayout
                                android:id="@+id/recents"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="@dimen/space_8"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/sub" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/sim"
                            style="@style/Widget.HudNav.Button.Tonal"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/action_height"
                            android:layout_marginEnd="@dimen/space_8"
                            android:text="@string/sim" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/go"
                            style="@style/Widget.HudNav.Button"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/action_height"
                            android:layout_weight="1"
                            android:text="@string/go" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/stop"
                            style="@style/Widget.HudNav.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/action_height"
                            android:layout_weight="1"
                            android:text="@string/stop"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/hud"
                        style="@style/Widget.HudNav.Chip"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/hud" />

                    <TextView
                        android:id="@+id/credit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/space_12"
                        android:text="@string/credit"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/sub" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
